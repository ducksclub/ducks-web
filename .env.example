# Private backend URL used only by the Nuxt server proxy.
NUXT_PRIVATE_API_BASE=http://localhost:3001/api

# Public API base used by the browser. Keep /api to route through server/api/[...path].ts.
NUXT_PUBLIC_API_BASE=/api

# Optional public base URL for uploaded media when image URLs are relative.
NUXT_PUBLIC_MEDIA_BASE=

# Optional public site URL used when building public promo links.
NUXT_PUBLIC_SITE_URL=
